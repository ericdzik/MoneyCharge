rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is the owner of the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Helper function to check if the user is an admin
    // This function assumes that an admin user has a 'role' field set to 'admin' in their own user document.
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Allow read access for any authenticated user. This is necessary so the app can display
      // merchant details to users. This can be tightened if needed.
      allow read: if request.auth != null;

      // Allow a user to create their own user document.
      // The role on creation must be 'user' or 'merchant', it cannot be 'admin'.
      allow create: if isOwner(userId) && (request.resource.data.role == 'user' || request.resource.data.role == 'merchant');

      // Allow a user to update their own document, BUT NOT their role.
      // Admins are allowed to update any user document (including the role).
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();

      // Only admins can delete user accounts.
      allow delete: if isAdmin();
    }

    // Rules for the 'reviews' subcollection
    match /users/{merchantId}/reviews/{reviewId} {
      // Any authenticated user can read reviews.
      allow read: if request.auth != null;

      // An authenticated user can create a review, and they must be the author of the review.
      allow create: if request.auth.uid == request.resource.data.userId;

      // A user can only update or delete their own reviews.
      allow update, delete: if request.auth.uid == resource.data.userId || isAdmin();
    }
  }
}
