rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Rules for Firebase Storage will go here.
    // By default, allow read/write access only for authenticated users.
    // You should customize these rules based on your app's needs.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
