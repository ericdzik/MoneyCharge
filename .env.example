# ========================================
# CONFIGURATION ENVIRONNEMENT - MoneyCharge
# ========================================
# IMPORTANT: Copiez ce fichier en .env et remplissez avec vos vraies clés
# NE JAMAIS commiter le fichier .env dans Git !

# ==================== ENVIRONNEMENT ====================
ENVIRONMENT=development
DEBUG_MODE=true
ENABLE_LOGGING=true

# ==================== API BACKEND ====================
API_BASE_URL=https://api.locacharge.com/v1
API_TIMEOUT=30

# ==================== GOOGLE MAPS ====================
# Clés différentes pour chaque plateforme (sécurité renforcée)
GOOGLE_MAPS_API_KEY_ANDROID=YOUR_ANDROID_MAPS_KEY_HERE
GOOGLE_MAPS_API_KEY_IOS=YOUR_IOS_MAPS_KEY_HERE
GOOGLE_MAPS_API_KEY_WEB=YOUR_WEB_MAPS_KEY_HERE

# Clé pour Google Directions API (utilisée par le service de directions)
GOOGLE_DIRECTIONS_API_KEY=YOUR_DIRECTIONS_API_KEY_HERE

# ==================== FIREBASE ====================
# Configuration Firebase pour toutes les plateformes
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_IOS_BUNDLE_ID=com.example.locacharge

# Firebase API Keys par plateforme
FIREBASE_API_KEY_WEB=YOUR_FIREBASE_WEB_KEY
FIREBASE_API_KEY_ANDROID=YOUR_FIREBASE_ANDROID_KEY
FIREBASE_API_KEY_IOS=YOUR_FIREBASE_IOS_KEY

# Firebase App IDs
FIREBASE_APP_ID_WEB=1:123456789012:web:abcdef123456
FIREBASE_APP_ID_ANDROID=1:123456789012:android:abcdef123456
FIREBASE_APP_ID_IOS=1:123456789012:ios:abcdef123456

# ==================== PAYSTACK ====================
# Clés Paystack pour les paiements
PAYSTACK_PUBLIC_KEY=pk_test_YOUR_PUBLIC_KEY_HERE
PAYSTACK_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
PAYSTACK_MODE=test

# ==================== NOTES DE SÉCURITÉ ====================
# 1. Ne JAMAIS commiter le fichier .env
# 2. Utiliser des clés différentes pour test/staging/production
# 3. Restreindre les clés API par domaine/bundle ID
# 4. Activer la facturation et les alertes sur Google Cloud
# 5. Révoquer les clés compromises immédiatement
# 6. Ne jamais utiliser PAYSTACK_SECRET_KEY côté client